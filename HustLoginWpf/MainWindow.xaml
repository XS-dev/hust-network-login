<Window x:Class="HustLogin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUST 校园网" Height="580" Width="420"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None" StateChanged="Window_StateChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="2"
                          Opacity="0.12" Direction="270"/>

        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPwdBox" TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="12" Effect="{StaticResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8FAFC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Height="36"
                    Background="#2563EB" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="HUST 校园网" Foreground="White"
                               FontFamily="Microsoft YaHei UI" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Foreground="White" FontSize="10"
                                FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                Width="40" Height="36" Cursor="Hand" Click="Min_Click"/>
                        <Button Content="X" Foreground="White" FontSize="11"
                                FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                Width="40" Height="36" Cursor="Hand" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="1" Margin="16,10,16,0" Background="#F1F5F9" CornerRadius="8" Padding="8,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#CBD5E1"
                                 StrokeThickness="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="等待检测..."
                                   FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="CountdownText" Text=""
                                   FontFamily="Microsoft YaHei UI" FontSize="11"
                                   Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LastCheckText" Text=""
                                   FontFamily="Microsoft YaHei UI" FontSize="10"
                                   Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Account card -->
            <Border Grid.Row="2" Background="White" CornerRadius="10"
                    Margin="16,8,16,0" Padding="16,14,16,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="账号" FontFamily="Microsoft YaHei UI" FontSize="11"
                               Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBox x:Name="UsernameBox" Style="{StaticResource ModernInput}"/>

                    <TextBlock Text="密码" FontFamily="Microsoft YaHei UI" FontSize="11"
                               Foreground="#94A3B8" Margin="0,10,0,2"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPwdBox}"/>

                    <TextBlock Text="检测间隔（秒）" FontFamily="Microsoft YaHei UI" FontSize="11"
                               Foreground="#94A3B8" Margin="0,10,0,2"/>
                    <TextBox x:Name="IntervalBox" Style="{StaticResource ModernInput}"
                             MaxLength="5" PreviewTextInput="Interval_PreviewTextInput"/>

                    <Grid Margin="0,12,0,0">
                        <CheckBox x:Name="AutoStartCheck" Content="开机自启"
                                  FontFamily="Microsoft YaHei UI" FontSize="11"
                                  Foreground="#94A3B8" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" Click="AutoStart_Click"/>
                        <Button x:Name="SaveBtn" Content="保 存"
                                FontFamily="Microsoft YaHei UI" FontSize="12"
                                Background="#2563EB" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Width="64" Height="32" HorizontalAlignment="Right"
                                Click="Save_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="6"
                                            Background="{TemplateBinding Background}"
                                            Cursor="{TemplateBinding Cursor}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Check button -->
            <Button Grid.Row="3" Content="立即检测"
                    FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Width="120" Height="36" HorizontalAlignment="Center"
                    Margin="0,10,0,0" Click="Check_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Log header -->
            <TextBlock Grid.Row="4" Text="检测记录" FontFamily="Microsoft YaHei UI"
                       FontSize="11" Foreground="#94A3B8"
                       Margin="20,10,0,2"/>

            <!-- Log list -->
            <ListBox x:Name="LogList" Grid.Row="5" Background="#F8FAFC"
                     BorderBrush="#E2E8F0" BorderThickness="1"
                     Margin="16,0,16,10" FontFamily="Consolas" FontSize="11"
                     Foreground="#475569" Padding="8" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,1,0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Bottom info -->
            <TextBlock Grid.Row="6" Text="HUST Network Login v2.0"
                       FontFamily="Microsoft YaHei UI" FontSize="9"
                       Foreground="#CBD5E1" HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
        </Grid>
    </Grid>
</Window>
